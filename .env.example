SESSION_SECRET="replace-with-a-long-random-value"
PUBLIC_STORE_DOMAIN="your-store.myshopify.com"
PUBLIC_STOREFRONT_API_TOKEN=""
PRIVATE_STOREFRONT_API_TOKEN=""
PUBLIC_STOREFRONT_ID=""
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=""
# Numeric Shopify shop ID; required by Hydrogen 2026.10 customer accounts.
SHOP_ID=""
# Legacy CLI value: only used to derive SHOP_ID when the explicit ID is absent.
PUBLIC_CUSTOMER_ACCOUNT_API_URL=""
PUBLIC_CHECKOUT_DOMAIN="checkout.example.com"
# Server-only Admin API token with write_customers and customer email/phone data access.
# Configure in Oxygen and locally for newsletter subscriptions and contact-phone sync.
SHOPIFY_ADMIN_API_ACCESS_TOKEN=""
# Newsletter: Dev Dashboard app installed on a store in the same organization.
# Server exchanges credentials for a token and renews it before expiry.
SHOPIFY_ADMIN_CLIENT_ID=""
SHOPIFY_ADMIN_CLIENT_SECRET=""
# Contact form: server-only Resend key and sender on a verified Resend domain.
# Configure both variables in Oxygen for production as well.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Rudimenterre <info@rudimenterre.com>"
# Shared contact rate limits (server only, writable REST token).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
